BaxterController(
				input signal bottleAtPoint, CMDfb;
				output String signal CMD;
				)
->{

// bottle loader
/* default is the gripper open */

	while(true)  {
	
		await(bottleAtPoint); /* step 1: wait until bottle is on the loading table */
		pause;
		// assume gripper is open
		
		/* step 2: lowers the arm to pos B */
		emit CMD("limb_moveto left_limb B");
		pause;
		await(CMDfb);
		
		/* step 3: closes gripper */
		emit CMD("limb_gripper left_limb close");
		pause;
		
		/* step 4: move arm to turntable, pos C */
		emit CMD("limb_moveto left_limb C");
		pause;
		await(CMDfb);
		
		/* step 5: move arm to right height, pos D */
		emit CMD("limb_moveto left_limb D");
		pause;
		await(CMDfb);
		
		/* step 6: open gripper */
		emit CMD("limb_gripper left_limb open");
		pause;
		
		/* step 7: move arm back to pickup location */
		emit CMD("limb_moveto left_limb A");
		pause;
		await(CMDfb);		
		}

}