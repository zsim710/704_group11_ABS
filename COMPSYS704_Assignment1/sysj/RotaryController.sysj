import run.GUI;

RotaryCD(
	input signal tableAlignedWithSensor, bottleLeftPos5RC, bottleAtPos1RC, capRemoved, capOnBottleAtPos1;
	input signal fillerReady, capperReady, lidLoaderReady;
	input Integer signal wsActiveRC, bottleTotalRC, BatchQuantityRC;
	output signal rotaryTableTrigger;
	output signal rotated, rotatedConvP, bottleAtPos2, bottleAtPos3, bottleAtPos4;
	)->	{
	
	{
		
		loop{
			pause;
			
			if ((Integer)#bottleTotalRC < (Integer)#BatchQuantityRC) {
				await (bottleAtPos1RC);
			}
			
			{await(fillerReady);}||{await(capperReady);}||{await(lidLoaderReady);}
			System.out.println("all ready signals received");

			present(capOnBottleAtPos1) {
				abort(capRemoved) {
					halt;
				}
			}
			
			present(!capOnBottleAtPos1){
				if ((Integer)#wsActiveRC > 4) {
					await (bottleLeftPos5RC);
				}
					
				trap(T){
					{sustain rotaryTableTrigger;}||{waitl(500 ms); exit(T);}
				}
				await(tableAlignedWithSensor);
				emit rotated;
				emit rotatedConvP;
				System.out.println("rotated emitted");
				
				pause;
				
			}
			
			
				
		}

	}
}
	
