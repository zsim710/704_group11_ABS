import run.GUI;

RotaryController(
	input signal tableAlignedWithSensor, bottleLeftPos5RC, bottleAtPos1RC, capRemoved, capOnBottleAtPos1;
	input signal fillerReady, capperReady, lidLoaderReady;
	input Integer signal wsActiveRC, bottleTotalRC, BatchQuantityRC;
	output signal rotaryTableTrigger, rotaryTableTriggerConvP;
	output signal rotated, rotatedM, rotatedConvP, bottleAtPos2, bottleAtPos3, bottleAtPos4, start_r;
	)->	{
	
	{
		//await (bottleAtPos1RC);
		System.out.println("got into controller");
		//pause;
		//emit start_r; should be inside since for some reason plant doesnt detect start? 
		loop{
			await(bottleAtPos1RC);
			emit start_r;
	
			//pause; // inserting pause to see if helps plant catch start_r
			System.out.println("emitted start");
			pause;

			
			if ((Integer)#bottleTotalRC < (Integer)#BatchQuantityRC) {
//				await(bottleAtPos1RC);
				System.out.println("received bottleAtPos1RC");
			}
			
			{await(fillerReady);}||{await(capperReady);}||{await(lidLoaderReady);}
			System.out.println("all ready signals received");
			

			present(capOnBottleAtPos1) {
				abort(capRemoved) {
					halt;
				}
			}
			
			present(!capOnBottleAtPos1){
				if ((Integer)#wsActiveRC > 4) {
					await (bottleLeftPos5RC);
				}
				
				System.out.println("awaiting trap");
				
				trap(T){
					{
						System.out.println("rotating");
						
						{sustain rotaryTableTrigger;}
						||
						{sustain rotaryTableTriggerConvP;}
						
					}
					||
					{waitl(0.5 s); exit(T);}
				}
				System.out.println("exited the trap");
				await(tableAlignedWithSensor);
				System.out.println("received aligned signal");
				emit rotated;
				emit rotatedConvP;
				emit rotatedM; // this goes directly to main controller 
				System.out.println("rotated emitted");
				
			}
				//pause;
				//pause;
				//pause;
		}

	}
}
	
