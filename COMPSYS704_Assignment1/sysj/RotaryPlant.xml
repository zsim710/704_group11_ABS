<System xmlns="http://systemjtechnology.com">
	<SubSystem Name="SS6" Local="true">
		<ClockDomain Name="RotaryPlantCD" Class="RotaryPlant">
			
			<iSignal Name="rotaryTableTrigger" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10004" />
			<iSignal Name="rotated" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10004"/>
			<iSignal Name="start_r" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10004"/>
			
			<iSignal Name="wsActiveRP" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10004" />
			<iSignal Name="bottleTotalRP" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10004"/>
			<iSignal Name="BatchQuantityRP" Class="com.systemj.ipc.SimpleServer" IP="127.0.0.1" Port="10004"/>
			

			<oSignal Name="tableAlignedWithSensor" To="RotaryControllerCD.tableAlignedWithSensor" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10003" />
			
			<oSignal Name="bottleAtPos2" To="FillerControllerCD.bottleAtPos2" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="33000" />
			<oSignal Name="bottleAtPos3" To="LidLoaderControllerCD.bottleAtPos3" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10000" />
			<oSignal Name="bottleAtPos4" To="CapperControllerCD.bottleAtPos4" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="31000" />
			<oSignal Name="bottleAtPos5" To="ConveyorPlantCD.bottleAtPos5" Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="40001" />
			
			
			<oSignal Name="rotation" To="UI.rotation"  Class="com.systemj.ipc.SimpleClient" IP="127.0.0.1" Port="10011" />
		</ClockDomain>
	</SubSystem>
</System>
