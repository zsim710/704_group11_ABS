CapperPlant(
		input signal cylPos5ZaxisExtend, gripperTurnRetract, gripperTurnExtend, capGripperPos5Extend, cylClampBottleExtend;
		input signal start; //from GUI
		output signal gripperZAxisLowered, gripperZAxisLifted, gripperTurnHomePos, gripperTurnFinalPos, capGripped, letGo;
		output signal bottleAtPos4E, gripperZAxisLoweredE, gripperZAxisLiftedE, gripperTurnHomePosE, gripperTurnFinalPosE, capIsGrippedE;
		)
->
{

	{
		while(true) {
			// wait until the start 
			await(immediate start);
			
			abort(cylPos5ZaxisExtend) {
					System.out.println("sustaining gripper at top");
					sustain gripperZAxisLifted;
				
			}

			System.out.println("waiting for gripper at bottom disable");
			pause;

			abort(!cylPos5ZaxisExtend) {
				{
					System.out.println("gripper at bottom");
					sustain gripperZAxisLowered;
				}
				||
				{ 
					System.out.println("waiting for gripped enable");
					pause;
					System.out.println("cap gripped sent");
					sustain capGripped;
				}
			}
			
			System.out.println("waiting for let go disable");
			System.out.println("waiting for let go enable");

			pause;
			abort(gripperTurnRetract) {
				System.out.println("let go emitted");
				sustain letGo;
			}
			
			System.out.println("looped");
		}

	}
	
	||
	
	{ 
		while(true) {
		
			abort (gripperTurnExtend) {
				//System.out.println("fully untwisted");
				sustain gripperTurnHomePos;
			}
		
			abort(gripperTurnRetract) {
				//System.out.println("fully twisted");
				sustain gripperTurnFinalPos;
			}
		}
	}

}



