import run.GUI;

RotaryPlant(
	input signal rotaryTableTrigger, rotated, start_r;
	input Integer signal wsActiveRP, bottleTotalRP, BatchQuantityRP;
	output signal tableAlignedWithSensor, rotation, bottleAtPos2, bottleAtPos3, bottleAtPos4, bottleAtPos5;
	)->{
		
		//new Thread(new GUI()).start();
		System.out.println("awaiting start");
		await(immediate start_r);
		System.out.println("received start");
		
		{
			// rotary motor function
			while(true){
		
				suspend(immediate rotaryTableTrigger){
				// do nothing
		//			sustain bottleAtPos1;
						
						//System.out.println("emitted aligned signal");
						pause;
						if ((Integer)#bottleTotalRP < (Integer)#BatchQuantityRP) { 
							if((Integer)#wsActiveRP == 2) {
								emit bottleAtPos2;
								System.out.println("emitted botteAtPos2");
							}
							else if((Integer)#wsActiveRP == 3) {
								emit bottleAtPos2;
								emit bottleAtPos3;		
								System.out.println("emitted botteAtPos3");
							}
							else if((Integer)#wsActiveRP == 4) {
								emit bottleAtPos2;
								emit bottleAtPos3;
								emit bottleAtPos4;	
								System.out.println("emitted botteAtPos4");
							}
							else if((Integer)#wsActiveRP == 5) {
								emit bottleAtPos2;
								emit bottleAtPos3;
								emit bottleAtPos4;
								emit bottleAtPos5;
								System.out.println("emitted botteAtPos5");
							}
							else {
								System.out.println("print error");
							}
						}
						
						//------------ switch to last 5 -------------
						else {
							if((Integer)#wsActiveRP == 4) {
								emit bottleAtPos2;
								emit bottleAtPos3;
								emit bottleAtPos4;
								emit bottleAtPos5;	
							}
							else if((Integer)#wsActiveRP == 3) {
								emit bottleAtPos3;
								emit bottleAtPos4;
								emit bottleAtPos5;	
								System.out.println("stopped emitting botteAtPos2");
							}
							else if((Integer)#wsActiveRP == 2) {
								emit bottleAtPos4;
								emit bottleAtPos5;	
								System.out.println("stopped emitting botteAtPos3");

							}
							else if((Integer)#wsActiveRP == 1) {
								emit bottleAtPos5;	
								System.out.println("stopped emitting botteAtPos4");

							}
							else {
								System.out.println("error 2");
							}
						}
					
				}
				System.out.println("awaiting disable");
				
				
				
				// maybe make this an integer and we can just read its current state for GUI 
			}
		}
		||
		{
			
			loop{
				pause;
				present(rotated){
					emit rotation;
					System.out.println("recieved rotation");
				}
				else {
					
				}
			}
			
		}
		||
		{
			loop{
				abort(immediate rotaryTableTrigger){
					System.out.println("emitting aligned sensor");
					sustain tableAlignedWithSensor;
				}
				pause;
			}
		}
	}