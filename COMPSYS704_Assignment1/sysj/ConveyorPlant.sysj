import run.GUI;

ConveyorPlant(
		input signal motConveyorOn, bottleAtPos5, rotatedConvP,start;
		output signal bottleAtPos1ConvC, bottleAtPos1RC, bottleAtPos1M;
		output signal bottleLeftPos5ConvC, bottleLeftPos5M, bottleLeftPos5RC;	
		
		// output GUIS 
		output signal bottleLeftPos5RotaryGUI, bottleAtPos1RotaryGUI; // to rotary GUI 
		output signal bottleAtPos1ConveyorGUI, bottleLeftPos5ConveyorGUI, bottleAtLoadGUI; 
		//output signal bottleAtLoaGUI, bottleLeftPos5GUI, bottleEmptyGUI;  // these output signals are sent to the UI

		)
->
{
//	new Thread(new GUI()).start();
	signal rotatedUpdated;
	
	await(immediate start);

	{
		loop {
			System.out.println("made it into conveyor");
			//pause; shouldnt need this because start and notconveyorON should be recieved at same time
			await(motConveyorOn);
			System.out.println("conveyor is moving");
			pause;
			
			System.out.println("bottle at pos1");
			//emit rotatedUpdated;
			abort(rotatedConvP){
				sustain bottleAtPos1ConvC; 
				}
			}
			//emit rotatedUpdated; // maybe we can emit this signal from rotary after its rotated straight to main controller 
			pause;
	}
	||
	{
		// position five monitoring -> 
		loop {
			pause;
			await(bottleAtPos5);
			pause;
			
			System.out.println("bottle left pos 5");
			emit bottleLeftPos5M;
			emit bottleLeftPos5ConvC;
			await(rotatedConvP);
		}
		
	}
	||
	{// To viz (GUI/duplicate signals) 
		{while(true){
			present(bottleAtPos1ConvC){
				emit bottleAtPos1RotaryGUI;
				//System.out.println("got it");
				emit bottleAtPos1ConveyorGUI;
				emit bottleAtPos1RC;
				
			} 
			pause;}
		}
		{
			while(true) {
				present(rotatedUpdated){
					emit bottleAtPos1M;
				}
				pause;
			}
		}
		||
		{while(true){present(bottleLeftPos5ConvC){emit bottleLeftPos5RotaryGUI;} pause;}}
		||
		{while(true) {present(motConveyorOn){emit bottleAtLoadGUI;} pause;}}
		
	}
	
}