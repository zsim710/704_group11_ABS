MainController(
input signal bottleAtPos1M,bottleLeftPos5M, enable;
input Integer signal BatchQuantity, LiquidAmount1, LiquidAmount2; 
output signal enableConvP, enableCapP, enableFP, enableRP, enableLL;
output Integer signal wsActive, wsActiveRC, wsActiveRP, wsActiveConvC, bottleTotal, bottleTotalRC, bottleTotalRP, bottleTotalConvC, BatchQuantityRC, BatchQuantityRP, BatchQuantityConvC, LiquidAmount1FC, LiquidAmount2FC;
)->{
	{
		emit wsActive(0);
		emit bottleTotal(0);

		loop {	
			
				present(bottleAtPos1M) {
					System.out.println("received bottleAtPos1M");
					emit wsActive((Integer)#wsActive + 1); 
					System.out.println("wsActive" + #wsActive);
					emit bottleTotal((Integer)#bottleTotal + 1); 
					System.out.println("bottleTotal" + #bottleTotal);
				}
				
				present(bottleLeftPos5M) {
					emit wsActive((Integer)#wsActive - 1); 
				}
				pause;
		}
	}
	||
	{
		pause;
		loop {
			present(wsActive) {
				System.out.println("emeitting wsActives" + #wsActive);
				emit wsActiveRC(#wsActive);
				emit wsActiveRP(#wsActive);
				emit wsActiveConvC(#wsActive);
			}
			
			present(bottleTotal) {
				System.out.println("emeitting bottleTotals");
				emit bottleTotalRC(#bottleTotal);
				emit bottleTotalRP(#bottleTotal);
				emit bottleTotalConvC(#bottleTotal);
			}
			
			present(BatchQuantity) {
				System.out.println("emeitting batchQuants");
				emit BatchQuantityRC(#BatchQuantity);
				emit BatchQuantityRP(#BatchQuantity);
				emit BatchQuantityConvC(#BatchQuantity);
			}
			pause;
		}
	}
	||
	{ 
		loop {
//			if (Integer)#bottleTotal =< ((Integer)#BatchQuantity + 2)) {
			System.out.println("emeitting liqs");
				emit LiquidAmount1FC;
				emit LiquidAmount2FC;
				pause;
//			/}
		}
	}
	||
	{
		loop {
			System.out.println("1");
			pause;
			pause;
			System.out.println("2");
			present(enable){
				System.out.println("3");
				if ((Integer)#bottleTotalRP < (Integer)#BatchQuantityRP) { 
					System.out.println("4");
					if((Integer)#wsActiveRP == 2) {
						emit enableConvP;
						emit enableFP;
						emit enableRP;
						
					}
					else if((Integer)#wsActiveRP == 3) {
						emit enableConvP;
						emit enableFP;
						emit enableRP;
						emit enableLL;
					}
					else if((Integer)#wsActiveRP == 4) {
						emit enableFP;
						emit enableCapP;
						emit enableConvP;
						emit enableRP;
						emit enableLL;		
					}
					else {
						System.out.println("5");
						emit enableConvP;
					}
				}
				//------------ switch to last 5 -------------
				else {
					if((Integer)#wsActiveRP == 4) {
						emit enableFP;
						emit enableCapP;
						emit enableConvP;
						emit enableRP;
						emit enableLL;	
					}
					else if((Integer)#wsActiveRP == 3) {
						emit enableCapP;
						emit enableConvP;
						emit enableRP;
						emit enableLL;	
					}
					else if((Integer)#wsActiveRP == 2) {
						emit enableCapP;
						emit enableConvP;
						emit enableRP;
							
					}
					else if((Integer)#wsActiveRP == 1) {
						emit enableConvP;
						emit enableRP;
							
					}
					else {
						emit enableConvP;
					}
				}
				
			}
			
		}
	}

}
	

