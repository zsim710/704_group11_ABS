MainController(
input signal bottleAtPos1M,bottleLeftPos5M, rotatedM;
input Integer signal posOrder, BatchQuantity, LiquidAmount1, LiquidAmount2; 
output Integer signal wsActiveRC, wsActiveRP, wsActiveConvC, bottleTotalRC, bottleTotalRP, bottleTotalConvC, BatchQuantityRC, BatchQuantityRP, BatchQuantityConvC, LiquidAmount1FC, LiquidAmount2FC;
output signal start_conveyor;
		)->{
	
int signal bottleTotal, wsActive;
	
emit wsActive(0);
emit bottleTotal(0);

await(immediate posOrder);
emit wsActive(1);
emit bottleTotal(1);

System.out.println("emiting start conveyor");
emit start_conveyor;

	{
		loop {	
			
				present(rotatedM) {
					// this will need a signal for when it recieved rotated but quantity == bottletotal then dont incrmeent botlte total anymore and wsactive  
					System.out.println("received rotatedM");
		
					emit wsActive((Integer)#wsActive + 1); 
					emit bottleTotal((Integer)#bottleTotal + 1); 
				}
				
				present(bottleLeftPos5M) {
					emit wsActive((Integer)#wsActive - 1); 
					System.out.println("decremented wsActive");
				}
				pause; // end up here on tick 2
		}
	}
	||
	{
		loop {
			present(wsActive) {
				System.out.println("emitting wsActives" + #wsActive);
				emit wsActiveRC(#wsActive);
				emit wsActiveRP(#wsActive);
				emit wsActiveConvC(#wsActive);
			}
			
			present(bottleTotal) {
				System.out.println("emitting bottleTotals");
				emit bottleTotalRC(#bottleTotal);
				emit bottleTotalRP(#bottleTotal);
				emit bottleTotalConvC(#bottleTotal);
			}
			
			present(BatchQuantity) {
				System.out.println("emitting batchQuants");
				emit BatchQuantityRC(#BatchQuantity);
				emit BatchQuantityRP(#BatchQuantity);
				emit BatchQuantityConvC(#BatchQuantity);
			}
			pause; // tick 2
		}
	}
	||
	{ 
		loop {
//			if (Integer)#bottleTotal =< ((Integer)#BatchQuantity + 2)) {
			System.out.println("emitting liqs");
				emit LiquidAmount1FC(#LiquidAmount1);
				emit LiquidAmount2FC(#LiquidAmount2);
				pause; // tick 2
//			/}
		}
	}
			
}
	

