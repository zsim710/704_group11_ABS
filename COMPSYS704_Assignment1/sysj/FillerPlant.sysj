FillerPlant(
input signal valveInjectorOn, valveInletOn, dosUnitValveRetract, dosUnitValveExtend, filler2Complete, start;
output signal dosUnitEvac,dosUnitFilled;
)->{
	
	
	{
	
	loop{
		abort(immediate filler2Complete) {
	
			await(immediate start);
	
			loop {
				
				System.out.println("recieved start");
				
				
				await(immediate valveInjectorOn);
	
				System.out.println("received valveInjectorOn");
	
				abort(immediate dosUnitValveExtend){

					System.out.println("sustaining dosUnitFilled");		
					sustain dosUnitFilled;
				}
				
				System.out.println("aborted dosUnitFilled");
	
				abort(immediate !valveInletOn) {
		
						System.out.println("sustaining dosUnitEvac");		
						sustain dosUnitEvac;
				}
				
				System.out.println("aborted dosUnitEvac");
			
				pause;
			
				System.out.println("looped");
			}
		}
		
		System.out.println("all fillers complete");
		pause;
		
		
		}
	}
	
}