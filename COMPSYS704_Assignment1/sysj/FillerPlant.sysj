FillerPlant(
input signal enableFP, valveInjectorOn, valveInletOn, dosUnitValveRetract, dosUnitValveExtend, filler2Complete;
output signal dosUnitEvac,dosUnitFilled;
output signal start;
)->{
	
	
	{
		
	abort(immediate filler2Complete) {
		await(enableFP);
		emit start;

		loop {
			
			
			System.out.println("awaiting starting enable");
			await(enableFP);
			System.out.println("completed starting enable");
			
			
			await(valveInjectorOn);
			//System.out.println("starting filler " + (Integer)#currentFiller);
			// injector turned on
			
			// if dosUnitValveRetract present then we sustain dosUnitFilled(at the top).
			// we stop sustaining (at the top) when controller forces pressure canister down
			System.out.println("awaiting disable 1");
			await(!enableFP);
			System.out.println("completed disable 1");
			
			System.out.println("awaiting enable 2");
			await(enableFP);
			System.out.println("completed enable 2");

			abort(dosUnitValveExtend){
					present(dosUnitValveRetract){
						sustain dosUnitFilled;
					}
			}
			
			System.out.println("awaiting disable 2");
			await(!enableFP);
			System.out.println("completed disable 2");
			// will sustain (at bottom) until they turn off the valve.
			
			System.out.println("awaiting enable 3");
			await(enableFP);
			System.out.println("completed enable 3");
			abort(!valveInletOn) {
					present(dosUnitValveExtend){
						sustain dosUnitEvac;
					}
			}
			
			System.out.println("awaiting disable 3");
			await(!enableFP);
			System.out.println("completed disable 3");
			
			System.out.println("awaiting enable 4");
			await(enableFP);
			System.out.println("completed enable 4");
			
			
			System.out.println("awaiting disable 4");
			await(!enableFP);
			System.out.println("completed disable 4");
			
			System.out.println("looped");
		}
	}
	
	System.out.println("all fillers complete");
	
	}
	
}