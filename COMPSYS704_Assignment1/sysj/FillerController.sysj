FillerController(
input signal bottleAtPos2,dosUnitEvac,dosUnitFilled;
input Integer signal LiquidAmount1FC, LiquidAmount2FC;
output signal fillerReady, valveInjectorOn, valveInletOn, dosUnitValveRetract, dosUnitValveExtend;
output signal filler2Complete, start;
)->{
	
	signal filler2CompleteLocal,filler2,filler1;
	int signal currentFiller;
	
	{	
		emit currentFiller(1);
		
		loop{
			abort(immediate filler2CompleteLocal){
				loop {	
					// condition check if idle			
					abort(immediate bottleAtPos2) { // default condition
						System.out.println("emitting filler ready");
						sustain fillerReady;
					}
					System.out.println("no longer emitting filler ready");
					//pause;
					//pause; //should be await start -> from plant 
					System.out.println("awaiting starting start signal");
					//await(immediate start);
					emit start;
		
					if ((Integer)#currentFiller == 1) {
						System.out.println("filler 1 start, filled " + ((Integer)#LiquidAmount1FC) + "%");
					}
					else if ((Integer)#currentFiller == 2) {
						System.out.println("filler 2 start, filled " + ((Integer)#LiquidAmount2FC) + "%");
					}else {
						System.out.println("filler 1 start, filled " + ((Integer)#LiquidAmount1FC) + "%");
					}
					
					// else active then everything else
					
		//			await(bottleAtPos2); // is this done in the same tick as the abort
					//System.out.println("bottle at pos2 in filler");
				
					pause;
					
					abort(dosUnitFilled){
						{
						System.out.println("toggles valve injector");
						sustain valveInjectorOn;
						}
						||
						{
						System.out.println("brings pressure canister up");
						sustain dosUnitValveRetract;
						}
					}
					
					abort(dosUnitEvac){
						{
						System.out.println("toggles valve inlet");
						sustain valveInletOn;
						}
						||
						{
						System.out.println("brings pressire canister down");
						sustain dosUnitValveExtend;
						}
					}
					
					System.out.println("filler is done");
					
					emit currentFiller(#currentFiller + 1); // increment the filler 
					pause;	
					
					
					
					// only want to await bottleAtPos2 once both fillers have finished 
					//await(!bottleAtPos2);
		
				}
			}
			await(currentFiller);
		
		}
	}
		||
		{
			while(true) {	
				pause;
				if((Integer)#currentFiller == 2) {
				emit filler2; 
				} else if ((Integer)#currentFiller == 1) {
					emit filler1;
				} else if((Integer)#currentFiller == 3) { // means filler is all complete
					emit filler2Complete;
					emit filler2CompleteLocal;
					emit fillerReady;
					//await(!bottleAtPos2); // await for 
					emit currentFiller(1); // reset current filler
				}
				else {
					// do nothing
				}
			}
		}
			
	

}
	

