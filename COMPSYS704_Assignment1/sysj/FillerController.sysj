FillerController(
input signal bottleAtPos2,dosUnitEvac,dosUnitFilled;
output signal fillerReady, valveInjectorOn, valveInletOn, dosUnitValveRetract, dosUnitValveExtend;
)->{
		
	{	
		loop {	
			// condition check if idle			
			abort(bottleAtPos2) { // default condition
				sustain fillerReady;
			}
			
			// else active then everything else
			System.out.println("bottle at pos2 in filler");
		
			pause;
			
			abort(dosUnitFilled){
				{
				System.out.println("toggles valve injector");
				sustain valveInjectorOn;
				}
				||
				{
				System.out.println("brings pressure canister up");
				sustain dosUnitValveRetract;
				}
			}
			
			abort(dosUnitEvac){
				{
				System.out.println("toggles valve inlet");
				sustain valveInletOn;
				}
				||
				{
				System.out.println("brings pressire canister down");
				sustain dosUnitValveExtend;
				}
			}
			
			System.out.println("filler is done");
			
			emit fillerReady;
			await(!bottleAtPos2);

		}
			
	}

}
	

